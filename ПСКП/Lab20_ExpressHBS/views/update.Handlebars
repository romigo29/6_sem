<h1>Редактирование записи</h1>

<div>
    {{#each contacts}}
    <span class="row-button disabled">
        {{name}} – {{phone}}
    </span><br>
    {{/each}}
</div>

<br>

<form action="/Update" method="POST">
    <input type="hidden" name="id" value="{{contact.id}}">
    <input type="text" name="name" id="editField" value="{{contact.name}}" required>
    <input type="text" name="phone" value="{{contact.phone}}" required>
    <button type="submit" class="btn">Изменить</button>
</form>

<br>

<form action="/Delete" method="POST">
    <input type="hidden" name="id" value="{{contact.id}}">
    <button type="submit" id="deleteBtn" class="btn danger">Удалить</button>
</form>

<br>

{{{cancelButton}}}
    "TDWA04_01_Y": {
      "commandName": "Project",
      "commandLineArgs": "Nick=Y Port=5002 Delay=2000",
      "applicationUrl": "http://localhost:5002"
    },
    "TDWA04_01_Z": {
      "commandName": "Project",
